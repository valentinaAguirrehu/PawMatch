# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pawmatch
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Opcional: Procesamiento de imágenes (true/false)
QUITAR_FONDO=false

# OpenAI. La clave solo vive en el servidor, nunca en la app Flutter.
# La entrevista de personalidad usa el modelo gpt-6-luna.
OPENAI_API_KEY=
# Voz a texto en Windows. En el celular se usa el reconocimiento del dispositivo.
OPENAI_TRANSCRIBE_MODEL=whisper-1
